---
import { Image } from "astro:assets";

import logoDark from "@/assets/logo_dark_full.svg";
import logoLight from "@/assets/logo_light.svg";

const navLinks = [
  { href: "/team", label: "Team" },
  { href: "/news", label: "News" },
  { href: "/publications", label: "Publications" },
  { href: "/sponsors", label: "Sponsors" },
  { href: "/press", label: "Press" },
  { href: "/contact", label: "Contact" },
];

// the current section, for the orange bar under its nav item
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => pathname === href || pathname.startsWith(href + "/");
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="brand" aria-label="whIRLwind home">
      <Image src={logoDark} alt="whIRLwind" height={54} width={150} class="only-light" loading="eager" />
      <Image src={logoLight} alt="whIRLwind" height={54} width={150} class="only-dark" loading="eager" />
    </a>

    <button
      type="button"
      class="nav__toggle"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="primary-navigation"
    >
      <!-- three lines that turn into a cross while open; see globals.css, .nav__icon -->
      <svg class="nav__icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
        <rect x="3" y="5" width="18" height="2"></rect>
        <rect x="3" y="11" width="18" height="2"></rect>
        <rect x="3" y="17" width="18" height="2"></rect>
      </svg>
    </button>

    <nav id="primary-navigation" class="nav" aria-label="Primary">
      <div class="nav__list">
        {
          navLinks.map((link) => (
            <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
              {link.label}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>

<script>
  // The narrow-screen menu: the button opens and closes it, Escape closes it.
  const header = document.querySelector<HTMLElement>(".header");
  const toggle = header?.querySelector<HTMLButtonElement>(".nav__toggle");
  if (header && toggle) {
    const set = (open: boolean) => {
      header.classList.toggle("header--open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };
    toggle.addEventListener("click", () => set(!header.classList.contains("header--open")));
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") set(false);
    });
  }
</script>
