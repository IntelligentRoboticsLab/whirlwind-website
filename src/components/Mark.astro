---
import { Image } from "astro:assets";

import markDark from "@/assets/logo_single_dark.svg";
import markLight from "@/assets/logo_light_single.svg";

// The swirl mark alone, indigo on paper and white on the dark canvas.
type Props = {
  class?: string;
  alt?: string;
  height?: number;
};

const { class: className = "", alt = "", height = 40 } = Astro.props;
const width = Math.round(height * (markDark.width / markDark.height));
---

<Image src={markDark} alt={alt} width={width} height={height} class={`only-light ${className}`} />
<Image src={markLight} alt={alt} width={width} height={height} class={`only-dark ${className}`} />
