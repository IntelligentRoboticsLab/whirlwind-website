---
import type { Competition } from "@/lib/seasons";
import Score from "./Score.astro";

// Every match of a competition, in the order played, ours first
// (DESIGN.md, section 9, "Results block").
type Props = { competition: Competition };
const { competition } = Astro.props;
const matches = competition.matches ?? [];
---

{
  matches.length ? (
    <section class="results-block" aria-labelledby={`results-${competition.id}`}>
      <h2 id={`results-${competition.id}`} class="t-heading">
        Results
      </h2>
      <table>
        <thead>
          <tr>
            <th scope="col">Stage</th>
            <th scope="col">Opponent</th>
            <th scope="col" class="num">
              Score
            </th>
          </tr>
        </thead>
        <tbody>
          {matches.map((m) => (
            <tr>
              <td>{m.stage}</td>
              <td>
                {m.opponent}
                {m.note ? <span class="t-meta"> {m.note}</span> : null}
              </td>
              <td class="num">
                <Score us={m.us} them={m.them} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ) : null
}
