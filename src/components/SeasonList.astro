---
import type { ArtworkName } from "@/lib/artwork";
import type { Season } from "@/lib/seasons";
import Opener from "./Opener.astro";
import Placing from "./Placing.astro";

// One season: heading, then every competition as a row (date, "event, city",
// result), newest first, with the next fixture on top carrying the orange bar
// and its dates in the result column (DESIGN.md, section 9). On the home page
// the current season's heading is an opener with a render in it.
type Props = {
  season: Season;
  headingLevel?: 2 | 3;
  artwork?: ArtworkName;
  at?: number;
};

const { season, headingLevel = 2, artwork, at = 70 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
const id = `season-${season.id}`;
---

<section class="season" aria-labelledby={id}>
  {
    artwork ? (
      <Opener id={id} artwork={artwork} at={at} level={headingLevel}>
        {season.label}
      </Opener>
    ) : (
      <Heading id={id} class={headingLevel === 2 ? "t-heading" : "t-subheading"}>
        {season.label}
      </Heading>
    )
  }
  <ol class="results">
    {
      season.competitions.map((c) => (
        <li class={c.upcoming ? "result result--next is-next" : "result"}>
          <span class="t-meta">{c.dateLabel}</span>
          <span>
            {c.newsSlug ? <a href={`/news/${c.newsSlug}`}>{c.name}</a> : c.name}, {c.place}
          </span>
          {c.upcoming ? (
            <span class="result__place result__place--word">{c.dates ?? "Next"}</span>
          ) : c.placing ? (
            <Placing figure={c.placing.figure} word={c.placing.word} />
          ) : (
            <span class="result__place t-meta">Result to be added</span>
          )}
        </li>
      ))
    }
  </ol>
</section>
