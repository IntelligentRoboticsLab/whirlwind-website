---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import { responsive } from "@/lib/images";

// A photograph with its caption and credit under it. Square corners, no frame,
// nothing on top (DESIGN.md, section 7).
type Props = {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  sizes?: string;
  priority?: boolean;
  class?: string;
};

const { src, alt, caption, credit, sizes, priority = false, class: className } = Astro.props;
---

<figure class:list={["figure", className]}>
  <Image src={src} alt={alt} {...responsive(src)} sizes={sizes} priority={priority} quality={85} />
  {
    caption || credit ? (
      <figcaption>
        {caption ? <span class="t-caption">{caption}</span> : null}
        {credit ? <span class="t-meta">{credit}</span> : null}
      </figcaption>
    ) : null
  }
</figure>
