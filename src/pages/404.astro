---
import Base from "@/layouts/Base.astro";
import Artwork from "@/components/Artwork.astro";
---

<Base title="Page not found">
  <div class="page">
    <section class="container opening" aria-label="Page not found">
      <div class="opening__text">
        <h1 class="t-display">Page not found</h1>
        <p class="t-lede">The ball went out. Nothing lives at this address.</p>
        <p class="t-body">
          <a href="/">Back to the home page</a>
        </p>
      </div>
      <div class="opening__art">
        <Artwork name="k1-fallen-back" />
      </div>
    </section>
  </div>
</Base>
